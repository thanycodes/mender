# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
POSTGRES_USER=mender
POSTGRES_PASSWORD=mender
POSTGRES_DB=mender
DATABASE_URL=postgresql+psycopg://mender:mender@localhost:5432/mender

# Llama API (Phase 2). Only backend/app/llm.py reads these.
LLAMA_API_KEY=
# Optional overrides: any OpenAI-compatible Llama host and model id
# LLAMA_BASE_URL=https://api.llama.com/compat/v1
# LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
